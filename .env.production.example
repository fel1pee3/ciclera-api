# Modelo seguro para cadastrar manualmente nas variáveis protegidas do Railway.
# Não copie valores locais e nunca versione uma cópia preenchida deste arquivo.
NODE_ENV=production
WEB_URL=https://app.seu-dominio.com.br
CORS_ORIGINS=https://app.seu-dominio.com.br
HTTP_BODY_LIMIT=100kb
LOG_LEVEL=info
TRUST_PROXY_HOPS=1

# Use secrets exclusivos gerados no ambiente de produção.
JWT_ACCESS_SECRET=replace-with-a-random-production-secret-at-least-32-characters
JWT_ACCESS_ISSUER=ciclera-api-production
JWT_ACCESS_AUDIENCE=ciclera-web-production
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
PASSWORD_RESET_TOKEN_TTL=1800
PASSWORD_RESET_DELIVERY_MODE=disabled
PUBLIC_REGISTRATION_ENABLED=false

# Mantenha strict quando web e API estiverem sob o mesmo domínio registrável,
# por exemplo app.ciclera.com.br e api.ciclera.com.br. Use none somente durante
# uma integração HTTPS realmente cross-site e valide o bloqueio de cookies de terceiros.
AUTH_COOKIE_SAME_SITE=strict

# Supabase Postgres via pooler de sessão (porta 5432). Cole a URL real somente no Railway.
DATABASE_URL=postgresql://user:password@host.pooler.supabase.com:5432/postgres?sslmode=require

# Bucket privado criado previamente no Supabase Storage.
EVIDENCE_STORAGE_DRIVER=supabase
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-the-supabase-secret-key
SUPABASE_STORAGE_BUCKET=ciclera-evidencias
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
UPLOAD_MAX_FILES_PER_EXECUTION=20
EVIDENCE_URL_TTL=300

# Credenciais REST da base Redis criada no Upstash.
RATE_LIMIT_STORAGE_DRIVER=upstash
UPSTASH_REDIS_REST_URL=https://replace-with-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-the-upstash-rest-token
