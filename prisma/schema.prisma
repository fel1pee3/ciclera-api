generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  OWNER
  ADMIN
  TECHNICIAN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ServiceLocationStatus {
  ACTIVE
  INACTIVE
}

enum WorkOrderStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  AWAITING_REVIEW
  PENDING_CORRECTION
  READY_TO_BILL
  BILLED
  CANCELED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EvidenceStatus {
  PENDING
  AVAILABLE
}

enum AdditionalItemType {
  MATERIAL
  SERVICE
  ADDITIONAL_HOUR
}

enum ReviewDecision {
  CORRECTION_REQUESTED
  APPROVED
}

enum ReviewReason {
  REQUIRED_PHOTO_MISSING
  MATERIAL_WITHOUT_VALUE
  ADDITIONAL_SERVICE_UNAPPROVED
  EQUIPMENT_DATA_INCORRECT
  INCONSISTENT_SCHEDULE
  OTHER
}

enum SubscriptionPlanCode {
  ESSENTIAL
  PROFESSIONAL
  OPERATION
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  ENDED
}

enum SubscriptionPaymentMethod {
  CREDIT_CARD
  PIX
  BOLETO
}

enum SubscriptionPaymentStatus {
  PENDING
  CONFIRMED
  RECEIVED
  OVERDUE
  REFUNDED
  CHARGEBACK
  CANCELED
}

enum SubscriptionCheckoutStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
}

model Organization {
  id                     String                     @id @default(uuid()) @db.Uuid
  name                   String                     @db.VarChar(160)
  timezone               String                     @default("America/Sao_Paulo") @db.VarChar(64)
  status                 OrganizationStatus         @default(ACTIVE)
  users                  User[]
  auditLogs              AuditLog[]
  customers              Customer[]
  locations              ServiceLocation[]
  equipment              Equipment[]
  workOrders             WorkOrder[]
  workOrderStatusHistory WorkOrderStatusHistory[]
  workOrderAssignments   WorkOrderAssignment[]
  workOrderExecutions    WorkOrderExecution[]
  evidence               Evidence[]
  additionalItems        AdditionalItem[]
  reviews                Review[]
  initialDataImports     InitialDataImport[]
  legalAcceptances       LegalAcceptance[]
  workOrderCounter       WorkOrderCounter?
  subscription           OrganizationSubscription?
  subscriptionPayments   SubscriptionPayment[]
  subscriptionCheckouts  SubscriptionCheckout[]
  subscriptionEvents     SubscriptionWebhookEvent[]
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@map("organizations")
}

model OrganizationSubscription {
  id                     String                     @id @default(uuid()) @db.Uuid
  organizationId         String                     @unique @map("organization_id") @db.Uuid
  organization           Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  planCode               SubscriptionPlanCode?      @map("plan_code")
  scheduledPlanCode      SubscriptionPlanCode?      @map("scheduled_plan_code")
  status                 SubscriptionStatus         @default(PENDING)
  paymentMethod          SubscriptionPaymentMethod? @map("payment_method")
  providerCustomerId     String?                    @unique @map("provider_customer_id") @db.VarChar(80)
  providerSubscriptionId String?                    @unique @map("provider_subscription_id") @db.VarChar(80)
  currentPeriodStart     DateTime?                  @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime?                  @map("current_period_end") @db.Timestamptz(6)
  nextDueDate            DateTime?                  @map("next_due_date") @db.Date
  overdueSince           DateTime?                  @map("overdue_since") @db.Date
  cancelAtPeriodEnd      Boolean                    @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?                  @map("canceled_at") @db.Timestamptz(6)
  version                Int                        @default(1)
  payments               SubscriptionPayment[]
  checkouts              SubscriptionCheckout[]
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([status, nextDueDate])
  @@map("organization_subscriptions")
}

model SubscriptionCheckout {
  id                 String                     @id @default(uuid()) @db.Uuid
  organizationId     String                     @map("organization_id") @db.Uuid
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subscriptionId     String                     @map("subscription_id") @db.Uuid
  subscription       OrganizationSubscription   @relation(fields: [organizationId, subscriptionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  planCode           SubscriptionPlanCode       @map("plan_code")
  paymentMethod      SubscriptionPaymentMethod  @map("payment_method")
  status             SubscriptionCheckoutStatus @default(PENDING)
  providerCheckoutId String?                    @unique @map("provider_checkout_id") @db.VarChar(100)
  expiresAt          DateTime                   @map("expires_at") @db.Timestamptz(6)
  completedAt        DateTime?                  @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@map("subscription_checkouts")
}

model SubscriptionPayment {
  id                     String                    @id @default(uuid()) @db.Uuid
  organizationId         String                    @map("organization_id") @db.Uuid
  organization           Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subscriptionId         String                    @map("subscription_id") @db.Uuid
  subscription           OrganizationSubscription  @relation(fields: [organizationId, subscriptionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  providerPaymentId      String                    @unique @map("provider_payment_id") @db.VarChar(100)
  providerSubscriptionId String?                   @map("provider_subscription_id") @db.VarChar(80)
  status                 SubscriptionPaymentStatus
  paymentMethod          SubscriptionPaymentMethod @map("payment_method")
  amountInCents          BigInt                    @map("amount_in_cents")
  dueDate                DateTime                  @map("due_date") @db.Date
  paidAt                 DateTime?                 @map("paid_at") @db.Timestamptz(6)
  invoiceUrl             String?                   @map("invoice_url") @db.VarChar(500)
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([organizationId, dueDate(sort: Desc), id])
  @@index([organizationId, status, dueDate])
  @@map("subscription_payments")
}

model SubscriptionWebhookEvent {
  id              String        @id @default(uuid()) @db.Uuid
  providerEventId String        @unique @map("provider_event_id") @db.VarChar(160)
  eventType       String        @map("event_type") @db.VarChar(100)
  organizationId  String?       @map("organization_id") @db.Uuid
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resourceId      String?       @map("resource_id") @db.VarChar(100)
  processedAt     DateTime      @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@index([organizationId, processedAt(sort: Desc)])
  @@map("subscription_webhook_events")
}

model Customer {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name               String            @db.VarChar(160)
  normalizedName     String            @map("normalized_name") @db.VarChar(160)
  document           String?           @db.VarChar(32)
  normalizedDocument String?           @map("normalized_document") @db.VarChar(32)
  email              String?           @db.VarChar(320)
  phone              String?           @db.VarChar(32)
  notes              String?           @db.VarChar(2000)
  archivedAt         DateTime?         @map("archived_at") @db.Timestamptz(6)
  locations          ServiceLocation[]
  equipment          Equipment[]
  workOrders         WorkOrder[]
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@unique([organizationId, normalizedDocument])
  @@index([organizationId, normalizedName, id])
  @@index([organizationId, archivedAt, id])
  @@map("customers")
}

model ServiceLocation {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customerId         String                @map("customer_id") @db.Uuid
  customer           Customer              @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  name               String                @db.VarChar(160)
  normalizedName     String                @map("normalized_name") @db.VarChar(160)
  postalCode         String                @map("postal_code") @db.VarChar(16)
  street             String                @db.VarChar(160)
  number             String                @db.VarChar(32)
  complement         String?               @db.VarChar(120)
  neighborhood       String                @db.VarChar(120)
  city               String                @db.VarChar(120)
  state              String                @db.Char(2)
  country            String                @default("BR") @db.Char(2)
  contactName        String?               @map("contact_name") @db.VarChar(160)
  contactPhone       String?               @map("contact_phone") @db.VarChar(32)
  accessInstructions String?               @map("access_instructions") @db.VarChar(1000)
  status             ServiceLocationStatus @default(ACTIVE)
  equipment          Equipment[]
  workOrders         WorkOrder[]
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@unique([organizationId, customerId, id])
  @@index([organizationId, customerId, status, normalizedName, id])
  @@map("service_locations")
}

model Equipment {
  id                     String          @id @default(uuid()) @db.Uuid
  organizationId         String          @map("organization_id") @db.Uuid
  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customerId             String          @map("customer_id") @db.Uuid
  customer               Customer        @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  locationId             String          @map("location_id") @db.Uuid
  location               ServiceLocation @relation(fields: [organizationId, customerId, locationId], references: [organizationId, customerId, id], onDelete: Restrict, onUpdate: Cascade)
  name                   String          @db.VarChar(160)
  normalizedName         String          @map("normalized_name") @db.VarChar(160)
  identifier             String          @db.VarChar(80)
  normalizedIdentifier   String          @map("normalized_identifier") @db.VarChar(80)
  category               String          @db.VarChar(120)
  brand                  String?         @db.VarChar(120)
  model                  String?         @db.VarChar(120)
  serialNumber           String?         @map("serial_number") @db.VarChar(120)
  normalizedSerialNumber String?         @map("normalized_serial_number") @db.VarChar(120)
  notes                  String?         @db.VarChar(2000)
  archivedAt             DateTime?       @map("archived_at") @db.Timestamptz(6)
  workOrders             WorkOrder[]
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@unique([organizationId, customerId, locationId, id])
  @@unique([organizationId, normalizedSerialNumber])
  @@index([organizationId, normalizedName, id])
  @@index([organizationId, normalizedIdentifier, id])
  @@index([organizationId, customerId, archivedAt, id])
  @@index([organizationId, locationId, archivedAt, id])
  @@map("equipment")
}

model User {
  id                     String                   @id @default(uuid()) @db.Uuid
  organizationId         String                   @map("organization_id") @db.Uuid
  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name                   String                   @db.VarChar(160)
  email                  String                   @db.VarChar(320)
  normalizedEmail        String                   @unique @map("normalized_email") @db.VarChar(320)
  passwordHash           String                   @map("password_hash") @db.VarChar(255)
  role                   UserRole                 @default(TECHNICIAN)
  status                 UserStatus               @default(ACTIVE)
  lastLoginAt            DateTime?                @map("last_login_at") @db.Timestamptz(6)
  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  auditLogs              AuditLog[]               @relation("AuditActor")
  createdWorkOrders      WorkOrder[]              @relation("WorkOrderCreator")
  canceledWorkOrders     WorkOrder[]              @relation("WorkOrderCanceler")
  workOrderStatusChanges WorkOrderStatusHistory[] @relation("WorkOrderStatusActor")
  assignedWorkOrders     WorkOrderAssignment[]    @relation("WorkOrderTechnician")
  createdAssignments     WorkOrderAssignment[]    @relation("WorkOrderAssignmentCreator")
  closedAssignments      WorkOrderAssignment[]    @relation("WorkOrderAssignmentCloser")
  workOrderExecutions    WorkOrderExecution[]     @relation("WorkOrderExecutionTechnician")
  createdEvidence        Evidence[]               @relation("EvidenceCreator")
  createdAdditionalItems AdditionalItem[]         @relation("AdditionalItemCreator")
  updatedAdditionalItems AdditionalItem[]         @relation("AdditionalItemUpdater")
  reviewsCreated         Review[]                 @relation("ReviewActor")
  billedWorkOrders       WorkOrder[]              @relation("WorkOrderBiller")
  initialDataImports     InitialDataImport[]      @relation("InitialDataImportCreator")
  legalAcceptances       LegalAcceptance[]
  deletedAt              DateTime?                @map("deleted_at") @db.Timestamptz(6)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([organizationId, status, role])
  @@index([organizationId, deletedAt, role])
  @@map("users")
}

model LegalAcceptance {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  termsVersion   String       @map("terms_version") @db.VarChar(32)
  privacyVersion String       @map("privacy_version") @db.VarChar(32)
  acceptedAt     DateTime     @default(now()) @map("accepted_at") @db.Timestamptz(6)

  @@unique([organizationId, userId, termsVersion, privacyVersion])
  @@index([organizationId, acceptedAt(sort: Desc)])
  @@map("legal_acceptances")
}

model WorkOrderCounter {
  organizationId String       @id @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lastNumber     BigInt       @default(0) @map("last_number")
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("work_order_counters")
}

model WorkOrder {
  id                    String                   @id @default(uuid()) @db.Uuid
  organizationId        String                   @map("organization_id") @db.Uuid
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  number                BigInt                   @map("work_order_number")
  customerId            String                   @map("customer_id") @db.Uuid
  customer              Customer                 @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  locationId            String                   @map("location_id") @db.Uuid
  location              ServiceLocation          @relation(fields: [organizationId, customerId, locationId], references: [organizationId, customerId, id], onDelete: Restrict, onUpdate: Cascade)
  equipmentId           String?                  @map("equipment_id") @db.Uuid
  equipment             Equipment?               @relation(fields: [organizationId, customerId, locationId, equipmentId], references: [organizationId, customerId, locationId, id], onDelete: Restrict, onUpdate: Cascade)
  serviceType           String                   @map("service_type") @db.VarChar(120)
  title                 String                   @db.VarChar(160)
  normalizedTitle       String                   @map("normalized_title") @db.VarChar(160)
  description           String                   @db.VarChar(4000)
  priority              WorkOrderPriority        @default(NORMAL)
  status                WorkOrderStatus          @default(DRAFT)
  scheduledStartAt      DateTime?                @map("scheduled_start_at") @db.Timestamptz(6)
  scheduledEndAt        DateTime?                @map("scheduled_end_at") @db.Timestamptz(6)
  actualStartAt         DateTime?                @map("actual_start_at") @db.Timestamptz(6)
  actualEndAt           DateTime?                @map("actual_end_at") @db.Timestamptz(6)
  expectedAmountInCents BigInt?                  @map("expected_amount_in_cents")
  finalAmountInCents    BigInt?                  @map("final_amount_in_cents")
  financialSnapshot     Json?                    @map("financial_snapshot")
  billedAt              DateTime?                @map("billed_at") @db.Timestamptz(6)
  billedByUserId        String?                  @map("billed_by_user_id") @db.Uuid
  billedBy              User?                    @relation("WorkOrderBiller", fields: [organizationId, billedByUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  version               Int                      @default(1)
  createdByUserId       String                   @map("created_by_user_id") @db.Uuid
  createdBy             User                     @relation("WorkOrderCreator", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  canceledByUserId      String?                  @map("canceled_by_user_id") @db.Uuid
  canceledBy            User?                    @relation("WorkOrderCanceler", fields: [organizationId, canceledByUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  canceledAt            DateTime?                @map("canceled_at") @db.Timestamptz(6)
  cancellationReason    String?                  @map("cancellation_reason") @db.VarChar(1000)
  statusHistory         WorkOrderStatusHistory[]
  assignments           WorkOrderAssignment[]
  execution             WorkOrderExecution?
  evidence              Evidence[]
  additionalItems       AdditionalItem[]
  reviews               Review[]
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt(sort: Desc), id])
  @@index([organizationId, status, finalAmountInCents])
  @@index([organizationId, status, billedAt(sort: Desc), id])
  @@index([organizationId, status, actualEndAt, id])
  @@index([organizationId, customerId, createdAt(sort: Desc), id])
  @@index([organizationId, scheduledStartAt, id])
  @@index([organizationId, normalizedTitle, id])
  @@map("work_orders")
}

model WorkOrderAssignment {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workOrderId        String       @map("work_order_id") @db.Uuid
  workOrder          WorkOrder    @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  technicianId       String       @map("technician_id") @db.Uuid
  technician         User         @relation("WorkOrderTechnician", fields: [organizationId, technicianId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  assignedByUserId   String       @map("assigned_by_user_id") @db.Uuid
  assignedBy         User         @relation("WorkOrderAssignmentCreator", fields: [organizationId, assignedByUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  assignedAt         DateTime     @default(now()) @map("assigned_at") @db.Timestamptz(6)
  unassignedByUserId String?      @map("unassigned_by_user_id") @db.Uuid
  unassignedBy       User?        @relation("WorkOrderAssignmentCloser", fields: [organizationId, unassignedByUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  unassignedAt       DateTime?    @map("unassigned_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([organizationId, workOrderId, assignedAt, id])
  @@index([organizationId, technicianId, unassignedAt, assignedAt])
  @@map("work_order_assignments")
}

model WorkOrderExecution {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workOrderId     String           @map("work_order_id") @db.Uuid
  workOrder       WorkOrder        @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  technicianId    String           @map("technician_id") @db.Uuid
  technician      User             @relation("WorkOrderExecutionTechnician", fields: [organizationId, technicianId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  notes           String?          @db.VarChar(4000)
  evidence        Evidence[]
  additionalItems AdditionalItem[]
  version         Int              @default(1)
  startedAt       DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@unique([organizationId, workOrderId])
  @@index([organizationId, technicianId, updatedAt(sort: Desc), id])
  @@map("work_order_executions")
}

model Evidence {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workOrderId     String             @map("work_order_id") @db.Uuid
  workOrder       WorkOrder          @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  executionId     String             @map("execution_id") @db.Uuid
  execution       WorkOrderExecution @relation(fields: [organizationId, executionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  createdByUserId String             @map("created_by_user_id") @db.Uuid
  createdBy       User               @relation("EvidenceCreator", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  status          EvidenceStatus     @default(PENDING)
  objectKey       String             @unique @map("object_key") @db.VarChar(500)
  fileName        String             @map("file_name") @db.VarChar(255)
  contentType     String             @map("content_type") @db.VarChar(120)
  sizeBytes       BigInt             @map("size_bytes")
  confirmedAt     DateTime?          @map("confirmed_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([organizationId, workOrderId, status, createdAt])
  @@index([organizationId, executionId, status, createdAt])
  @@map("evidence")
}

model AdditionalItem {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workOrderId        String             @map("work_order_id") @db.Uuid
  workOrder          WorkOrder          @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  executionId        String             @map("execution_id") @db.Uuid
  execution          WorkOrderExecution @relation(fields: [organizationId, executionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  type               AdditionalItemType
  description        String             @db.VarChar(500)
  quantityInThousand BigInt             @map("quantity_in_thousand")
  unitAmountInCents  BigInt             @map("unit_amount_in_cents")
  totalAmountInCents BigInt             @map("total_amount_in_cents")
  createdByUserId    String             @map("created_by_user_id") @db.Uuid
  createdBy          User               @relation("AdditionalItemCreator", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  updatedByUserId    String             @map("updated_by_user_id") @db.Uuid
  updatedBy          User               @relation("AdditionalItemUpdater", fields: [organizationId, updatedByUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([organizationId, workOrderId, createdAt, id])
  @@index([organizationId, executionId, createdAt, id])
  @@map("additional_items")
}

model Review {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workOrderId    String         @map("work_order_id") @db.Uuid
  workOrder      WorkOrder      @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  actorUserId    String         @map("actor_user_id") @db.Uuid
  actor          User           @relation("ReviewActor", fields: [organizationId, actorUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  decision       ReviewDecision
  reason         ReviewReason?
  description    String?        @db.VarChar(2000)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([organizationId, workOrderId, createdAt(sort: Desc), id])
  @@index([organizationId, decision, createdAt(sort: Desc), id])
  @@map("reviews")
}

model WorkOrderStatusHistory {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workOrderId    String           @map("work_order_id") @db.Uuid
  workOrder      WorkOrder        @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  previousStatus WorkOrderStatus? @map("previous_status")
  newStatus      WorkOrderStatus  @map("new_status")
  actorUserId    String           @map("actor_user_id") @db.Uuid
  actor          User             @relation("WorkOrderStatusActor", fields: [organizationId, actorUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  reason         String?          @db.VarChar(1000)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, workOrderId, createdAt, id])
  @@map("work_order_status_history")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUserId    String       @map("actor_user_id") @db.Uuid
  actor          User         @relation("AuditActor", fields: [organizationId, actorUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  action         String       @db.VarChar(80)
  resourceType   String       @map("resource_type") @db.VarChar(80)
  resourceId     String       @map("resource_id") @db.Uuid
  requestId      String       @map("request_id") @db.VarChar(128)
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, resourceType, resourceId, createdAt(sort: Desc)])
  @@index([organizationId, actorUserId, createdAt(sort: Desc)])
