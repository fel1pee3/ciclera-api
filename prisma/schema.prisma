generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  OWNER
  ADMIN
  TECHNICIAN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ServiceLocationStatus {
  ACTIVE
  INACTIVE
}

enum WorkOrderStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  AWAITING_REVIEW
  PENDING_CORRECTION
  READY_TO_BILL
  BILLED
  CANCELED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Organization {
  id                     String                   @id @default(uuid()) @db.Uuid
  name                   String                   @db.VarChar(160)
  timezone               String                   @default("America/Sao_Paulo") @db.VarChar(64)
  status                 OrganizationStatus       @default(ACTIVE)
  users                  User[]
  auditLogs              AuditLog[]
  customers              Customer[]
  locations              ServiceLocation[]
  equipment              Equipment[]
  workOrders             WorkOrder[]
  workOrderStatusHistory WorkOrderStatusHistory[]
  workOrderAssignments   WorkOrderAssignment[]
  workOrderCounter       WorkOrderCounter?
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@map("organizations")
}

model Customer {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name               String            @db.VarChar(160)
  normalizedName     String            @map("normalized_name") @db.VarChar(160)
  document           String?           @db.VarChar(32)
  normalizedDocument String?           @map("normalized_document") @db.VarChar(32)
  email              String?           @db.VarChar(320)
  phone              String?           @db.VarChar(32)
  notes              String?           @db.VarChar(2000)
  archivedAt         DateTime?         @map("archived_at") @db.Timestamptz(6)
  locations          ServiceLocation[]
  equipment          Equipment[]
  workOrders         WorkOrder[]
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@unique([organizationId, normalizedDocument])
  @@index([organizationId, normalizedName, id])
  @@index([organizationId, archivedAt, id])
  @@map("customers")
}

model ServiceLocation {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customerId         String                @map("customer_id") @db.Uuid
  customer           Customer              @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  name               String                @db.VarChar(160)
  normalizedName     String                @map("normalized_name") @db.VarChar(160)
  postalCode         String                @map("postal_code") @db.VarChar(16)
  street             String                @db.VarChar(160)
  number             String                @db.VarChar(32)
  complement         String?               @db.VarChar(120)
  neighborhood       String                @db.VarChar(120)
  city               String                @db.VarChar(120)
  state              String                @db.Char(2)
  country            String                @default("BR") @db.Char(2)
  contactName        String?               @map("contact_name") @db.VarChar(160)
  contactPhone       String?               @map("contact_phone") @db.VarChar(32)
  accessInstructions String?               @map("access_instructions") @db.VarChar(1000)
  status             ServiceLocationStatus @default(ACTIVE)
  equipment          Equipment[]
  workOrders         WorkOrder[]
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@unique([organizationId, customerId, id])
  @@index([organizationId, customerId, status, normalizedName, id])
  @@map("service_locations")
}

model Equipment {
  id                     String          @id @default(uuid()) @db.Uuid
  organizationId         String          @map("organization_id") @db.Uuid
  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customerId             String          @map("customer_id") @db.Uuid
  customer               Customer        @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  locationId             String          @map("location_id") @db.Uuid
  location               ServiceLocation @relation(fields: [organizationId, customerId, locationId], references: [organizationId, customerId, id], onDelete: Restrict, onUpdate: Cascade)
  name                   String          @db.VarChar(160)
  normalizedName         String          @map("normalized_name") @db.VarChar(160)
  identifier             String          @db.VarChar(80)
  normalizedIdentifier   String          @map("normalized_identifier") @db.VarChar(80)
  category               String          @db.VarChar(120)
  brand                  String?         @db.VarChar(120)
  model                  String?         @db.VarChar(120)
  serialNumber           String?         @map("serial_number") @db.VarChar(120)
  normalizedSerialNumber String?         @map("normalized_serial_number") @db.VarChar(120)
  notes                  String?         @db.VarChar(2000)
  archivedAt             DateTime?       @map("archived_at") @db.Timestamptz(6)
  workOrders             WorkOrder[]
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@unique([organizationId, customerId, locationId, id])
  @@unique([organizationId, normalizedSerialNumber])
  @@index([organizationId, normalizedName, id])
  @@index([organizationId, normalizedIdentifier, id])
  @@index([organizationId, customerId, archivedAt, id])
  @@index([organizationId, locationId, archivedAt, id])
  @@map("equipment")
}

model User {
  id                     String                   @id @default(uuid()) @db.Uuid
  organizationId         String                   @map("organization_id") @db.Uuid
  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name                   String                   @db.VarChar(160)
  email                  String                   @db.VarChar(320)
  normalizedEmail        String                   @unique @map("normalized_email") @db.VarChar(320)
  passwordHash           String                   @map("password_hash") @db.VarChar(255)
  role                   UserRole                 @default(TECHNICIAN)
  status                 UserStatus               @default(ACTIVE)
  lastLoginAt            DateTime?                @map("last_login_at") @db.Timestamptz(6)
  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  auditLogs              AuditLog[]               @relation("AuditActor")
  createdWorkOrders      WorkOrder[]              @relation("WorkOrderCreator")
  canceledWorkOrders     WorkOrder[]              @relation("WorkOrderCanceler")
  workOrderStatusChanges WorkOrderStatusHistory[] @relation("WorkOrderStatusActor")
  assignedWorkOrders     WorkOrderAssignment[]    @relation("WorkOrderTechnician")
  createdAssignments     WorkOrderAssignment[]    @relation("WorkOrderAssignmentCreator")
  closedAssignments      WorkOrderAssignment[]    @relation("WorkOrderAssignmentCloser")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([organizationId, status, role])
  @@map("users")
}

model WorkOrderCounter {
  organizationId String       @id @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lastNumber     BigInt       @default(0) @map("last_number")
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("work_order_counters")
}

model WorkOrder {
  id                    String                   @id @default(uuid()) @db.Uuid
  organizationId        String                   @map("organization_id") @db.Uuid
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  number                BigInt                   @map("work_order_number")
  customerId            String                   @map("customer_id") @db.Uuid
  customer              Customer                 @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  locationId            String                   @map("location_id") @db.Uuid
  location              ServiceLocation          @relation(fields: [organizationId, customerId, locationId], references: [organizationId, customerId, id], onDelete: Restrict, onUpdate: Cascade)
  equipmentId           String?                  @map("equipment_id") @db.Uuid
  equipment             Equipment?               @relation(fields: [organizationId, customerId, locationId, equipmentId], references: [organizationId, customerId, locationId, id], onDelete: Restrict, onUpdate: Cascade)
  serviceType           String                   @map("service_type") @db.VarChar(120)
  title                 String                   @db.VarChar(160)
  normalizedTitle       String                   @map("normalized_title") @db.VarChar(160)
  description           String                   @db.VarChar(4000)
  priority              WorkOrderPriority        @default(NORMAL)
  status                WorkOrderStatus          @default(DRAFT)
  scheduledStartAt      DateTime?                @map("scheduled_start_at") @db.Timestamptz(6)
  scheduledEndAt        DateTime?                @map("scheduled_end_at") @db.Timestamptz(6)
  actualStartAt         DateTime?                @map("actual_start_at") @db.Timestamptz(6)
  actualEndAt           DateTime?                @map("actual_end_at") @db.Timestamptz(6)
  expectedAmountInCents BigInt?                  @map("expected_amount_in_cents")
  finalAmountInCents    BigInt?                  @map("final_amount_in_cents")
  version               Int                      @default(1)
  createdByUserId       String                   @map("created_by_user_id") @db.Uuid
  createdBy             User                     @relation("WorkOrderCreator", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  canceledByUserId      String?                  @map("canceled_by_user_id") @db.Uuid
  canceledBy            User?                    @relation("WorkOrderCanceler", fields: [organizationId, canceledByUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  canceledAt            DateTime?                @map("canceled_at") @db.Timestamptz(6)
  cancellationReason    String?                  @map("cancellation_reason") @db.VarChar(1000)
  statusHistory         WorkOrderStatusHistory[]
  assignments           WorkOrderAssignment[]
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt(sort: Desc), id])
  @@index([organizationId, customerId, createdAt(sort: Desc), id])
  @@index([organizationId, scheduledStartAt, id])
  @@index([organizationId, normalizedTitle, id])
  @@map("work_orders")
}

model WorkOrderAssignment {
  id                     String       @id @default(uuid()) @db.Uuid
  organizationId         String       @map("organization_id") @db.Uuid
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workOrderId            String       @map("work_order_id") @db.Uuid
  workOrder              WorkOrder    @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  technicianId           String       @map("technician_id") @db.Uuid
  technician             User         @relation("WorkOrderTechnician", fields: [organizationId, technicianId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  assignedByUserId       String       @map("assigned_by_user_id") @db.Uuid
  assignedBy             User         @relation("WorkOrderAssignmentCreator", fields: [organizationId, assignedByUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  assignedAt             DateTime     @default(now()) @map("assigned_at") @db.Timestamptz(6)
  unassignedByUserId     String?      @map("unassigned_by_user_id") @db.Uuid
  unassignedBy           User?        @relation("WorkOrderAssignmentCloser", fields: [organizationId, unassignedByUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  unassignedAt           DateTime?    @map("unassigned_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([organizationId, workOrderId, assignedAt, id])
  @@index([organizationId, technicianId, unassignedAt, assignedAt])
  @@map("work_order_assignments")
}

model WorkOrderStatusHistory {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workOrderId    String           @map("work_order_id") @db.Uuid
  workOrder      WorkOrder        @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  previousStatus WorkOrderStatus? @map("previous_status")
  newStatus      WorkOrderStatus  @map("new_status")
  actorUserId    String           @map("actor_user_id") @db.Uuid
  actor          User             @relation("WorkOrderStatusActor", fields: [organizationId, actorUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  reason         String?          @db.VarChar(1000)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, workOrderId, createdAt, id])
  @@map("work_order_status_history")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUserId    String       @map("actor_user_id") @db.Uuid
  actor          User         @relation("AuditActor", fields: [organizationId, actorUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  action         String       @db.VarChar(80)
  resourceType   String       @map("resource_type") @db.VarChar(80)
  resourceId     String       @map("resource_id") @db.Uuid
  requestId      String       @map("request_id") @db.VarChar(128)
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, resourceType, resourceId, createdAt(sort: Desc)])
  @@index([organizationId, actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  familyId         String    @default(uuid()) @map("family_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason String?   @map("revocation_reason") @db.VarChar(160)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId, userId, revokedAt, expiresAt])
  @@index([familyId])
  @@map("sessions")
}

model PasswordResetToken {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  tokenHash      String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, userId, usedAt, expiresAt])
  @@map("password_reset_tokens")
}
