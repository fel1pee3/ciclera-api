model Session {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  familyId         String    @default(uuid()) @map("family_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason String?   @map("revocation_reason") @db.VarChar(160)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId, userId, revokedAt, expiresAt])
  @@index([familyId])
  @@map("sessions")
}

model PasswordResetToken {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  tokenHash      String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, userId, usedAt, expiresAt])
  @@map("password_reset_tokens")
}

model InitialDataImport {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  checksum        String       @db.Char(64)
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdBy       User         @relation("InitialDataImportCreator", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  result          Json
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, checksum])
  @@index([organizationId, createdAt(sort: Desc), id])
  @@map("initial_data_imports")
}
