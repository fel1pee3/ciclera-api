# PostgreSQL exclusivamente local. Copie para .env e troque a senha localmente.
# Nunca reutilize estes valores em staging ou produção.
NODE_ENV=development
PORT=3333
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
HTTP_BODY_LIMIT=100kb
LOG_LEVEL=info
TRUST_PROXY_HOPS=0

# Autenticação exclusivamente local. Troque o secret em cada ambiente real.
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-local-only
JWT_ACCESS_ISSUER=ciclera-api-local
JWT_ACCESS_AUDIENCE=ciclera-web-local
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
PASSWORD_RESET_TOKEN_TTL=1800
PASSWORD_RESET_DELIVERY_MODE=local
# Cadastro público deve ser habilitado explicitamente. Mantenha false em produção
# até existir verificação de e-mail e a infraestrutura externa estar aprovada.
PUBLIC_REGISTRATION_ENABLED=true
AUTH_COOKIE_SAME_SITE=strict

# Evidências privadas locais. O diretório não é servido publicamente.
EVIDENCE_STORAGE_DRIVER=local
EVIDENCE_STORAGE_ROOT=.local/evidence
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
UPLOAD_MAX_FILES_PER_EXECUTION=20
EVIDENCE_URL_TTL=300

# Apenas desenvolvimento/teste. Produção exige um backend distribuído.
RATE_LIMIT_STORAGE_DRIVER=memory

# Cobrança SaaS. Em desenvolvimento fica desligada até o Sandbox do Asaas ser configurado.
SUBSCRIPTION_ENFORCEMENT_ENABLED=false
# ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# ASAAS_API_KEY=replace-with-the-sandbox-api-key
# ASAAS_WEBHOOK_TOKEN=replace-with-an-independent-random-token-32-to-255-characters

# Produção usa EVIDENCE_STORAGE_DRIVER=supabase e
# RATE_LIMIT_STORAGE_DRIVER=upstash. Consulte .env.production.example.

POSTGRES_USER=ciclera_local
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=ciclera
POSTGRES_PORT=55432

# Os testes criam e removem automaticamente um schema isolado neste mesmo banco.
# TEST_DATABASE_URL nunca deve ser persistida no .env.
DATABASE_URL=postgresql://ciclera_local:replace-with-a-local-only-password@localhost:55432/ciclera
